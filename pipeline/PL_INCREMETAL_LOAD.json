{
	"name": "PL_INCREMETAL_LOAD",
	"properties": {
		"activities": [
			{
				"name": "Lookuplastupdated_value",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@select pipeline().parameters.source_table_column as watermark_value pipeline().parameters.source_table_column",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "sitionpremsource",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Lookupcurrentwatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@concat (' SELECT MAX(', pipeline().parameters.source_table_column, ') as newwatermark_value from ', pipeline().parameters.source_table)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "sitionpremsource",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookuplastupdated_value",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Lookupcurrentwatermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "@select * from {pipeline().parameters.source_table} where {pipeline().parameters.source_table_column} > {activity('Lookuplastupdated_value').output.watermark_value} and {pipeline().parameters.source_table_column} <= {activity('Lookupcurrentwatermark').output.newwatermark_value}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "sitionpremsource",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "Targettest",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Stored procedure1",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[source_config_tbl]",
					"storedProcedureParameters": {
						"LastModified_date": {
							"value": {
								"value": "@activity('Lookupcurrentwatermark').output.value",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"tbl_name": {
							"value": {
								"value": "@pipeline().parameters.source_table",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "SITIompremls",
					"type": "LinkedServiceReference"
				}
			}
		],
		"parameters": {
			"source_table": {
				"type": "string"
			},
			"watermark_tbl": {
				"type": "string"
			},
			"watermark_value": {
				"type": "string"
			},
			"dest_container": {
				"type": "string"
			},
			"source_table_column": {
				"type": "string"
			}
		},
		"annotations": []
	}
}